generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // If you're on Supabase's pooled connection string (port 6543 / pgbouncer)
  // or Neon's pooler, migrations need a *direct* (unpooled) connection.
  // Uncomment below and set DIRECT_URL in your .env to the non-pooled URL.
  // directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) adapter models.
// Required verbatim shape for @auth/prisma-adapter. We keep session strategy
// as "jwt" in auth.ts (so middleware stays Edge-compatible without a Prisma
// Edge driver), which means the `Session` table below is present for adapter
// type-compatibility but isn't actively written to. `Account` IS used — it's
// how Google identities get linked to a persisted `User` row.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// App domain models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Onboarding profile — powers the personalized Sleep Score ring.
  // All nullable: a user can skip onboarding and use the app with no ring
  // (an "add your profile" prompt shows instead until these are set).
  biologicalSex String? // "female" | "male"
  heightCm      Int?
  weightKg      Float?
  dateOfBirth   DateTime?
  onboardedAt   DateTime? // set once onboarding is completed OR explicitly skipped

  accounts      Account[]
  sessions      Session[]
  sleepSessions SleepSession[]

  createdAt DateTime @default(now())
}

model SleepSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startTime   DateTime
  endTime     DateTime?
  durationMin Int? // calculated on wake: round((endTime - startTime) / 60000)
  quality     Int? // 1-5 "how do you feel" rating, set on wake or shortly after

  createdAt DateTime @default(now())

  // Powers "find my currently-active session" and the 7-day analytics query.
  @@index([userId, startTime])
  @@index([userId, endTime])
}
